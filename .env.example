# Documentation placeholders only. Django does not load this file automatically.
# Export values in your shell; never commit a real key or a populated .env file.
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-me-with-a-generated-random-key-of-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Stripe TEST MODE only. Set privately in your environment, never in Git.
STRIPE_TEST_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_ORIGIN=http://localhost:8000
# For the separately approved Heroku app, set DJANGO_ENV=production and:
# DJANGO_DEPLOYMENT=heroku
# DATABASE_URL= (supplied privately by SkillSeat's own PostgreSQL attachment)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-skillseat-app.herokuapp.com
# DJANGO_ALLOWED_HOSTS=your-skillseat-app.herokuapp.com
# PAYMENT_ORIGIN=https://your-skillseat-app.herokuapp.com
